# Copie para .env e preencha. O .env esta no .gitignore de proposito:
# chave commitada e chave vazada.

# Obrigatoria, minimo de 32 bytes. Gere com: openssl rand -base64 48
# Fica vazia aqui de proposito: um exemplo preenchido acaba usado como esta.
COFRE_JWT_SECRET=

# Obrigatoria. Senha do Postgres, gere com: openssl rand -hex 24
# O Postgres so aplica a senha na primeira subida, quando cria o volume.
# Para trocar depois: docker compose down -v (apaga os dados) ou ALTER USER.
DB_PASSWORD=

COFRE_IA_API_KEY=
